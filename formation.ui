    border: none;
    font-size: 13px; /* Augmenter la taille du texte */
    font-weight: bold;
    padding: 12px; /* Espacement pour agrandir le bouton */
    border-radius: 8px;
    text-align: center; /* Centrer le texte */
    qproperty-iconSize: 32px 32px; /* Agrandir l'icône */
}

QPushButton:hover {
    background-color: #D0E3FF; /* Couleur au survol */
}

QPushButton:pressed {
    background-color: #D0E3FF; /* Bleu foncé lorsqu'on clique */
    color: white;
}
