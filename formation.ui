          <property name="styleSheet">
           <string notr="true">QComboBox {
    background-color: #020230;
    color: white;
    border-radius: 15px;
    padding: 5px;
    font-size: 16px;
    border: none;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px; /* Largeur du bouton de la flèche */
    border-left-width: 1px;
    border-left-color: darkgray;
    border-left-style: solid;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    background-color: transparent; /* Fond transparent pour la flèche */
    image: url(Desktop\projet c++\icones); /* Chemin vers l'icône de flèche blanche */
}

QComboBox QAbstractItemView {
    background-color: #020230;
    color: white;
    selection-background-color: #5555FF;
}</string>
