      <property name="styleSheet">
       <string notr="true">QPushButton {
    background-color: #E8F1FF; /* Couleur de fond initiale */
    color: #000000; /* Couleur du texte */
    border: none;
    font-size: 16px; /* Augmenter la taille du texte */
    font-weight: bold;
    padding: 12px; /* Espacement pour agrandir le bouton */
    border-radius: 8px;
    text-align: center; /* Centrer le texte */
    qproperty-iconSize: 32px 32px; /* Agrandir l'icône */
}

QPushButton:hover {
    background-color: #D0E3FF; /* Couleur au survol */
}

QPushButton:pressed {
    background-color: #1461C7; /* Bleu foncé lorsqu'on clique */
